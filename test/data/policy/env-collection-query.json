{
  "name": "env-collection-query",
  "version": 1,
  "priority": 1,
  "selection": {
    "envCollection": {
      "@eq": "subscribed"
    }
  },
  "env": {
    "userId": "#env.user.id"
  },
  "config": [
    {
      "verbs": ["GET", "QUERY"],
      "schema": ["board"],
      "query": {
        "subscribed": {
          "@eq": "#env.userId"
        }
      }
    },
    {
      "verbs": ["GET", "QUERY"],
      "schema": ["post"],
      "env": {
        "boardIds": {
          "collection": "board",
          "type": "array",
          "query": {
            "subscribed": {
              "@eq": "#env.user.id"
            }
          },
          "output": {
            "key": "id",
            "type": "id"
          }
        }
      },
      "query": {
        "boardId": {
          "@in": "#env.boardIds"
        }
      }
    }
  ]
}
