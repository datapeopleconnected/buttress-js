#!/usr/bin/env bash
# Git GUIs and agent shells don't load nvm, so use the version pinned in .nvmrc.
export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
[ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh" && nvm use --silent >/dev/null

set -e

# eslint --fix + prettier --write on the staged src files ("lint-staged" in package.json).
# --if-present: worktrees on branches that predate the script share this hook.
npm run --if-present lint:staged

npm run licence-check
npm run build
